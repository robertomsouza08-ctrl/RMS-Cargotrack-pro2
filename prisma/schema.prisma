
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shipment {
  id          String   @id @default(cuid())
  code        String   @unique
  origin      String
  destination String
  status      String   @default("IN_TRANSIT")
  eta         DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
